{
  "expo": {
    "name": "السجل الرقمي",
    "slug": "digital-record",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "digitalrecord",
    "userInterfaceStyle": "light",
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "de": "./locales/de.json",
      "tr": "./locales/tr.json",
      "pt": "./locales/pt.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kh11kk.digitalrecord",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Digital Record uses the camera to capture receipts and add them to your records. AI reading is optional; the image is sent for analysis only after your consent.",
        "NSPhotoLibraryUsageDescription": "Digital Record allows you to select receipt photos to add to your records. AI reading is optional; the image is sent for analysis only after your consent."
      }
    },
    "android": {
      "package": "com.kh11kk.digitalrecord",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#102B4E"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#102B4E"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2463EB",
          "defaultChannel": "deadlines"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Digital Record allows you to select receipt photos to add to your records. AI reading is optional; the image is sent for analysis only after your consent.",
          "cameraPermission": "Digital Record uses the camera to capture receipts and add them to your records. AI reading is optional; the image is sent for analysis only after your consent.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "63c38093-fadf-45e6-bb05-f7bc5c2b1b94"
      },
      "supportEmail": "digitalrecord.app.help@gmail.com",
      "privacyPolicyUrl": "https://kh11kk00-netizen.github.io/digital-record-site/privacy.html"
    },
    "experiments": {
      "typedRoutes": false
    },
    "description": "Save invoices, warranties and important reminders. Review optional AI invoice extraction before saving."
  }
}
